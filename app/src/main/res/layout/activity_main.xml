<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="QUẢN LÝ THƯ VIỆN"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBookManagement"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="1. Quản lý danh sách sách"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSearchBook"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="2. Tìm kiếm sách"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnBorrowManagement"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="3. Quản lý mượn / trả sách"
        android:textSize="16sp" />

</LinearLayout>
